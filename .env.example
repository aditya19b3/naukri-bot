# =========================================================
# Naukri Auto-Apply Bot - Environment Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual .env file to version control.
# =========================================================

# ---- Naukri credentials ----
NAUKRI_EMAIL=adityabaghel125@gmail.com
NAUKRI_PASSWORD=xHx&7*JSL.Hz3Fy

# ---- Applicant profile (used to fill quick-apply forms) ----
FIRST_NAME=Aditya
LAST_NAME=Baghel

# ---- Search parameters ----
# Comma-separated list of keywords
KEYWORDS=Gen AI Developer,Java Developer
LOCATION=Bangalore, Chennai, Pune, Noida
# Number of search-result pages to scan per keyword
PAGES_PER_KEYWORD=2
# Hard cap on total applications submitted in a single run
MAX_APPLICATIONS=20

# ---- Browser behavior ----
# true/false - run Chrome without a visible window
HEADLESS=false
# Optional: explicit path to chromedriver.exe (Windows). Leave blank to
# let webdriver-manager download/manage it automatically.
CHROMEDRIVER_PATH=

# ---- Timing / rate limiting ----
# Explicit-wait timeout in seconds
WAIT_TIMEOUT=15
# Random delay range (seconds) inserted between actions to look human
MIN_DELAY=2
MAX_DELAY=5

# ---- Output ----
OUTPUT_DIR=output
CSV_FILENAME=results.csv
JSON_FILENAME=results.json

# ---- Google Sheets sync (optional, for the future SaaS pipeline) ----
GOOGLE_SHEETS_ENABLED=false
# Path to a Google service-account JSON key file
GOOGLE_SHEETS_CREDENTIALS_PATH=service_account.json
# The spreadsheet ID (from the sheet's URL) to append results to
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Results

# ---- Codex / OpenAI AI Integration ----
CODEX_API_KEY=
CODEX_API_BASE_URL=https://api.openai.com/v1/chat/completions
CODEX_MODEL=gpt-4o-mini

# ---- Detailed Applicant Profile for AI answering ----
YEARS_OF_EXPERIENCE=3
CURRENT_CTC=8 LPA
EXPECTED_CTC=12 LPA
NOTICE_PERIOD=30 days
SKILLS=Python, Generative AI, LLMs, Java, Spring Boot, SQL
CURRENT_LOCATION=Bangalore
PREFERRED_LOCATIONS=Bangalore, Pune, Noida

# ---- Extended AI Applicant Profile details ----
GENDER=Male
GRADUATION_YEAR=2024
HIGHEST_QUALIFICATION=B.Tech
CURRENT_COMPANY=
WORK_AUTHORIZATION=Yes
SHIFT_FLEXIBILITY=Yes

